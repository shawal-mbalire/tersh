{
  "name": "tersh",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run typecheck && bun --bun vite build",
    "typecheck": "bun --bun ngc -p tsconfig.json",
    "test": "bun test",
    "tauri": "bun --bun x tauri"
  },
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@fontsource-variable/sono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "marked": "^18.1.1",
    "marked-katex-extension": "^5.1.13",
    "plotly.js-dist-min": "^4.1.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular/build": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/plotly.js-dist-min": "^2.3.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  }
}
