{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun"],
    "strict": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@ports/*": ["./src/ports/*"],
      "@app/*": ["./src/app/*"],
      "@adapters/*": ["./src/adapters/*"],
      "@tersh/cards": ["./packages/cards/src/index.ts"],
      "@tersh/cards/styles.css": ["./packages/cards/src/styles.css"],
      "@cards/*": ["./packages/cards/src/*"],
      "@frontend/package.json": ["./package.json"]
    }
  },
  "include": ["src", "packages/cards/src", "packages/cards/test", "vite.config.ts", "aliases.ts", "test-setup.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  }
}
